	pages = {1732--1742},
	file = {ScienceDirect Snapshot:/Users/florianmischke/Zotero/storage/HJGFZMFQ/S0013794406000877.html:text/html},
}

@article{riegler_comparison_2025,
	title = {Comparison of autorotation and propulsive landing for planetary exploration},
	volume = {234},
	issn = {0094-5765},
	url = {https://www.sciencedirect.com/science/article/pii/S0094576525002073},
	doi = {10.1016/j.actaastro.2025.04.008},
	abstract = {In the rapidly evolving field of space exploration, the focus lies not only on enhancing launch capabilities but also on improving landing technologies on Earth and other celestial bodies. Propellant-based systems currently dominate targeted landings since they allow a high degree of control in a variety of environments. While this enables high precision and hazard avoidance capabilities, these propulsion systems impose a significant mass penalty, particularly over longer distances. This work explores an alternative descent and landing method: autorotation, a well-established mechanism in helicopter emergency landings. Autorotation trades the propellant-based propulsion system for a rotor system that requires no fuel, allowing for substantial horizontal distance coverage with minimal mass impact. In this paper, its potential for missions on Earth, Mars, Titan, and Venus is analyzed, comparing its efficiency to traditional propulsive approaches. The results show that autorotation outperforms propulsion in most scenarios, offering a promising alternative even under conservative assumptions. These findings highlight the potential of autorotation as a viable, mass-efficient descent and landing method for future missions.},
	urldate = {2026-10-28},
	journal = {Acta Astronautica},
	author = {Riegler, Clemens and Mutter, Julian and Kayal, Hakan},
	month = sep,
	year = {2025},
	keywords = {Autorotation, Mars, Propulsion, Titan, Venus},
	pages = {26--40},
	file = {ScienceDirect Full Text PDF:/Users/florianmischke/Zotero/storage/PUWDAEL3/Riegler et al. - 2025 - Comparison of autorotation and propulsive landing for planetary exploration.pdf:application/pdf;ScienceDirect Snapshot:/Users/florianmischke/Zotero/storage/FPPHV9A2/S0094576525002073.html:text/html},
}

