@article{lentink_leading-edge_2009,
	title = {Leading-{Edge} {Vortices} {Elevate} {Lift} of {Autorotating} {Plant} {Seeds}},
	volume = {324},
	issn = {0036-8075, 1095-9203},
	url = {https://www.science.org/doi/10.1126/science.1174196},
	doi = {10.1126/science.1174196},
	abstract = {Helicopter Seed Lift
            
              The “helicopter” seeds of maple trees and other similar autorotating seeds detach from their parent tree under windy conditions and gyrate as they are dispersed by the wind. The reproductive success of the tree depends on the flight performance of its seeds. Autorotating seeds are known to generate high lift as they slowly descend through the air, but the means by which they do so is unclear.
              
                Lentink
                et al.
              
              (p.
              1438
              , see the cover) have elucidated the aerodynamic mechanism for high lift in autorotating seeds using a robot model seed and a three-dimensional flow measurement technique. Maple seeds and a hornbeam seed create a prominent leading-edge vortex that is similar to the flow structures that are responsible for the high lift generated by the wings of hovering insects and bats. Thus, both animals and plants have converged on an identical aerodynamic solution for generating lift.
            
          , 
            Winged plant seeds use leading edge vortices to create lift, in the same way that flying animals do.
          , 
            As they descend, the autorotating seeds of maples and some other trees generate unexpectedly high lift, but how they attain this elevated performance is unknown. To elucidate the mechanisms responsible, we measured the three-dimensional flow around dynamically scaled models of maple and hornbeam seeds. Our results indicate that these seeds attain high lift by generating a stable leading-edge vortex (LEV) as they descend. The compact LEV, which we verified on real specimens, allows maple seeds to remain in the air more effectively than do a variety of nonautorotating seeds. LEVs also explain the high lift generated by hovering insects, bats, and possibly birds, suggesting that the use of LEVs represents a convergent aerodynamic solution in the evolution of flight performance in both animals and plants.},
	language = {en},
	number = {5933},
	urldate = {2026-04-01},
	journal = {Science},
	author = {Lentink, D. and Dickson, W. B. and Van Leeuwen, J. L. and Dickinson, M. H.},
	month = jun,
	year = {2009},
	pages = {1438--1440},
	file = {PDF:/Users/florianmischke/Zotero/storage/CK7ZGCKC/Lentink et al. - 2009 - Leading-Edge Vortices Elevate Lift of Autorotating Plant Seeds.pdf:application/pdf},
}

@article{liu_maple-seed-inspired_2026,
	title = {Maple-seed-inspired rotochute},
	volume = {38},
	issn = {1070-6631, 1089-7666},
	url = {https://pubs.aip.org/pof/article/38/3/036120/3383820/Maple-seed-inspired-rotochute},
	doi = {10.1063/5.0301390},
	abstract = {The maple seed has a winged structure that autorotates during descent, thus generating leading-edge vortices, providing enhanced lift and reducing descent velocity. Inspired by this flight principle, we developed a minimalist rotochute that is comprised of a wing, a payload, and a counterweight. At the laboratory scale, the maple seed-inspired (MSI) rotochute exhibited excellent descent performance, achieving a descent velocity as low as 0.94 m/s and a rotation velocity as low as 71.47 rad/s. The ratio of its descending velocity to mass demonstrated that the MSI rotochute had better efficacy than the natural maple seed. By integrating the blade element theory and Eulerian equations, a theory of the MSI rotochute in steady descent and rotation was proposed to quantify its flight behavior. Both the descent and rotation velocities increase as the payload–counterweight mass ratio or the leading edge–counterweight mass ratio is increased. When the payload moves away from the center of mass in the spanwise direction, the descent velocity decreases slightly, but the rotation velocity increases slightly. To validate these theoretical results, experimental measurements in a custom-designed wind tunnel were performed and good agreement with theoretical predictions observed. This study provides guidelines for designing novel MSI rotochutes for a range of applications, such as airdropping, emergency escape from tall buildings, and recovery of unmanned aerial vehicles.},
	language = {en},
	number = {3},
	urldate = {2026-04-01},
	journal = {Physics of Fluids},
	author = {Liu, Shaobao and Niu, Peixing and Li, Ying and Jiao, Chongxi and Li, Moxiao and Yang, Yuze and Wang, Shunan and Lu, Tian Jian},
	month = mar,
	year = {2026},
	keywords = {1},
	pages = {036120},
	file = {PDF:/Users/florianmischke/Zotero/storage/KBJBKUZN/Liu et al. - 2026 - Maple-seed-inspired rotochute.pdf:application/pdf},
}

