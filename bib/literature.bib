@article{liu_maple-seed-inspired_2026,
	title = {Maple-seed-inspired rotochute},
	volume = {38},
	issn = {1070-6631, 1089-7666},
	url = {https://pubs.aip.org/pof/article/38/3/036120/3383820/Maple-seed-inspired-rotochute},
	doi = {10.1063/5.0301390},
	abstract = {The maple seed has a winged structure that autorotates during descent, thus generating leading-edge vortices, providing enhanced lift and reducing descent velocity. Inspired by this flight principle, we developed a minimalist rotochute that is comprised of a wing, a payload, and a counterweight. At the laboratory scale, the maple seed-inspired (MSI) rotochute exhibited excellent descent performance, achieving a descent velocity as low as 0.94 m/s and a rotation velocity as low as 71.47 rad/s. The ratio of its descending velocity to mass demonstrated that the MSI rotochute had better efficacy than the natural maple seed. By integrating the blade element theory and Eulerian equations, a theory of the MSI rotochute in steady descent and rotation was proposed to quantify its flight behavior. Both the descent and rotation velocities increase as the payload–counterweight mass ratio or the leading edge–counterweight mass ratio is increased. When the payload moves away from the center of mass in the spanwise direction, the descent velocity decreases slightly, but the rotation velocity increases slightly. To validate these theoretical results, experimental measurements in a custom-designed wind tunnel were performed and good agreement with theoretical predictions observed. This study provides guidelines for designing novel MSI rotochutes for a range of applications, such as airdropping, emergency escape from tall buildings, and recovery of unmanned aerial vehicles.},
	language = {en},
	number = {3},
	urldate = {2026-04-01},
	journal = {Physics of Fluids},
	author = {Liu, Shaobao and Niu, Peixing and Li, Ying and Jiao, Chongxi and Li, Moxiao and Yang, Yuze and Wang, Shunan and Lu, Tian Jian},
	month = mar,
	year = {2026},
	keywords = {1},
	pages = {036120},
	file = {PDF:/Users/florianmischke/Zotero/storage/KBJBKUZN/Liu et al. - 2026 - Maple-seed-inspired rotochute.pdf:application/pdf},
}

@article{kim_three-dimensional_2021,
	title = {Three-dimensional electronic microfliers inspired by wind-dispersed seeds},
	volume = {597},
	copyright = {2021 The Author(s), under exclusive licence to Springer Nature Limited},
	issn = {1476-4687},
	url = {https://www.nature.com/articles/s41586-021-03847-y},
	doi = {10.1038/s41586-021-03847-y},
	abstract = {Large, distributed collections of miniaturized, wireless electronic devices1,2 may form the basis of future systems for environmental monitoring3, population surveillance4, disease management5 and other applications that demand coverage over expansive spatial scales. Aerial schemes to distribute the components for such networks are required, and—inspired by wind-dispersed seeds6—we examined passive structures designed for controlled, unpowered flight across natural environments or city settings. Techniques in mechanically guided assembly of three-dimensional (3D) mesostructures7–9 provide access to miniature, 3D fliers optimized for such purposes, in processes that align with the most sophisticated production techniques for electronic, optoelectronic, microfluidic and microelectromechanical technologies. Here we demonstrate a range of 3D macro-, meso- and microscale fliers produced in this manner, including those that incorporate active electronic and colorimetric payloads. Analytical, computational and experimental studies of the aerodynamics of high-performance structures of this type establish a set of fundamental considerations in bio-inspired design, with a focus on 3D fliers that exhibit controlled rotational kinematics and low terminal velocities. An approach that represents these complex 3D structures as discrete numbers of blades captures the essential physics in simple, analytical scaling forms, validated by computational and experimental results. Battery-free, wireless devices and colorimetric sensors for environmental measurements provide simple examples of a wide spectrum of applications of these unusual concepts.},
	language = {en},
	number = {7877},
	urldate = {2026-04-01},
	journal = {Nature},
	publisher = {Nature Publishing Group},
	author = {Kim, Bong Hoon and Li, Kan and Kim, Jin-Tae and Park, Yoonseok and Jang, Hokyung and Wang, Xueju and Xie, Zhaoqian and Won, Sang Min and Yoon, Hong-Joon and Lee, Geumbee and Jang, Woo Jin and Lee, Kun Hyuck and Chung, Ted S. and Jung, Yei Hwan and Heo, Seung Yun and Lee, Yechan and Kim, Juyun and Cai, Tengfei and Kim, Yeonha and Prasopsukh, Poom and Yu, Yongjoon and Yu, Xinge and Avila, Raudel and Luan, Haiwen and Song, Honglie and Zhu, Feng and Zhao, Ying and Chen, Lin and Han, Seung Ho and Kim, Jiwoong and Oh, Soong Ju and Lee, Heon and Lee, Chi Hwan and Huang, Yonggang and Chamorro, Leonardo P. and Zhang, Yihui and Rogers, John A.},
	month = sep,
	year = {2021},
	keywords = {Aerospace engineering, Electronic devices, Fluid dynamics, Fluidics, Mechanical engineering},
	pages = {503--510},
	file = {PDF:/Users/florianmischke/Zotero/storage/9887B9BN/Kim et al. - 2021 - Three-dimensional electronic microfliers inspired by wind-dispersed seeds.pdf:application/pdf},
}

@article{yang_biomimetic_2017,
